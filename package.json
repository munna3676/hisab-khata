{
  "name": "hisab-khata",
  "private": true,
  "description": "হিসাব খাতা — টাকা, ব্যাংক আর সরকারি কাজের হিসাব, এক খাতায়",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.22" },
  "scripts": {
    "dev": "pnpm --filter @hisab/web dev",
    "build": "pnpm tokens && pnpm --filter @hisab/web build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm tokens && pnpm -r --if-present typecheck && tsc -p tests/visual --noEmit",
    "test:visual": "playwright test -c tests/visual/playwright.config.ts",
    "shots": "playwright test -c tests/visual/playwright.config.ts gallery.shots",
    "tokens": "pnpm --filter @hisab/tokens build",
    "check:data": "node scripts/check-data.mjs",
    "check:js": "node scripts/check-js-budget.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
