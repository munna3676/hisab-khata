{
  "name": "@hisab/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "হিসাব খাতা website: Astro static site (Bangla at /, English under /en/)",
  "scripts": {
    "tokens": "node ../../packages/tokens/build.mjs",
    "dev": "node ../../packages/tokens/build.mjs && astro dev --ignore-lock",
    "build": "node ../../packages/tokens/build.mjs && astro build",
    "preview": "astro preview --ignore-lock",
    "typecheck": "node ../../packages/tokens/build.mjs && astro check"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.0",
    "@fontsource/anek-bangla": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "@hisab/core": "workspace:*",
    "@hisab/data": "workspace:*",
    "@hisab/i18n": "workspace:*",
    "@hisab/platform": "workspace:*",
    "@hisab/search": "workspace:*",
    "@hisab/tokens": "workspace:*",
    "@hisab/ui": "workspace:*",
    "@preact/signals": "2.11.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "motion": "14.4.0",
    "preact": "10.29.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
