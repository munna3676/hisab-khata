{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hisabkhata.app/schema/special-days.json",
  "title": "Special days",
  "description": "data/dates/special-days.json: national days shown with a date, @hisab/core SpecialDay[].",
  "type": "object",
  "$ref": "fact.json",
  "properties": {
    "value": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "calendar",
          "month",
          "day",
          "name"
        ],
        "properties": {
          "calendar": {
            "enum": [
              "gregorian",
              "bangla"
            ]
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  }
}
