{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hisabkhata.app/schema/board-subjects.json",
  "title": "Board subjects",
  "description": "data/education/board-subjects.json: subject rows of the GPA screen, by exam and group (curriculum, not used by the engine).",
  "type": "object",
  "$ref": "fact.json",
  "properties": {
    "value": {
      "type": "object",
      "required": [],
      "properties": {
        "ssc": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "common.json#/$defs/id"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "hsc": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "common.json#/$defs/id"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
