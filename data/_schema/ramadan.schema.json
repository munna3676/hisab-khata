{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hisabkhata.app/schema/ramadan.json",
  "title": "Ramadan",
  "description": "data/religion/ramadan.json: this year's Ramadan start as announced after moon sighting.",
  "type": "object",
  "$ref": "fact.json",
  "properties": {
    "value": {
      "type": "object",
      "required": [
        "hijriYear",
        "start",
        "days"
      ],
      "properties": {
        "hijriYear": {
          "type": "integer",
          "minimum": 1400,
          "maximum": 1600
        },
        "start": {
          "$ref": "common.json#/$defs/date"
        },
        "days": {
          "type": "integer",
          "minimum": 29,
          "maximum": 30
        }
      },
      "additionalProperties": false
    }
  }
}
