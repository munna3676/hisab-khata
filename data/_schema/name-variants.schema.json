{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hisabkhata.app/schema/name-variants.json",
  "title": "Name variants",
  "description": "data/text/name-variants.json: spellings the name checker treats as the same name part. Editorial, not Facts.",
  "type": "object",
  "required": [
    "groups"
  ],
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "variants"
        ],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "uniqueItems": true
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
