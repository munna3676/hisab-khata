{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hisabkhata.app/schema/common.json",
  "title": "Shared definitions",
  "description": "Building blocks the data file schemas share.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable kebab-case id."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD."
    },
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "localized": {
      "type": "object",
      "required": [
        "bn",
        "en"
      ],
      "properties": {
        "bn": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "upTo": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Row limit (inclusive); null on the open last row."
    },
    "gradeBand": {
      "type": "object",
      "required": [
        "grade",
        "minMarks",
        "point"
      ],
      "properties": {
        "grade": {
          "type": "string",
          "minLength": 1
        },
        "minMarks": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "point": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "gradeScale": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gradeBand"
      },
      "minItems": 2
    }
  }
}
