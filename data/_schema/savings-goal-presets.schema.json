{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hisabkhata.app/schema/savings-goal-presets.json",
  "title": "Savings goal presets",
  "description": "data/finance/savings-goal-presets.json: the কিসের জন্য chips; target and months are optional hints.",
  "type": "object",
  "$ref": "fact.json",
  "properties": {
    "value": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "labelBn"
        ],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "labelBn": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "number",
            "minimum": 0
          },
          "months": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  }
}
