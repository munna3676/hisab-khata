{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hisabkhata.app/schema/holidays.json",
  "title": "Holidays",
  "description": "data/dates/holidays-<year>.json: the Cabinet Division's holiday list for one year, @hisab/core Holiday[].",
  "type": "object",
  "$ref": "fact.json",
  "properties": {
    "value": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "name"
        ],
        "properties": {
          "date": {
            "$ref": "common.json#/$defs/date"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "public",
              "executive",
              "optional"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
