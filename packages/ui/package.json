{
  "name": "@hisab/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "হিসাব খাতা component library: Preact TSX components, icons and motion utilities shared by the website and the app",
  "sideEffects": ["*.css"],
  "exports": {
    "./base": "./src/base/index.ts",
    "./nav": "./src/nav/index.ts",
    "./content": "./src/content/index.ts",
    "./overlay": "./src/overlay/index.ts",
    "./icons": "./src/icons/index.ts",
    "./lib": "./src/lib/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./motion.css": "./src/styles/motion.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hisab/core": "workspace:*",
    "@hisab/tokens": "workspace:*",
    "@preact/signals": "2.11.3",
    "clsx": "2.1.1",
    "motion": "14.4.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@testing-library/preact": "3.2.4",
    "happy-dom": "21.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
