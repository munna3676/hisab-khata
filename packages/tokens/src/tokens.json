  },
  "font": {
    "family": {
      "display": "'Anek Bangla', 'Noto Sans Bengali', sans-serif",
      "body": "'Noto Sans Bengali', system-ui, sans-serif",
      "number": "'IBM Plex Mono', ui-monospace, monospace"
    },
    "style": {
      "display-desktop-h1": {
        "family": "display",
        "weight": 700,
        "size": 44,
        "lineHeight": 54
      },
      "h1": {
        "family": "display",
        "weight": 700,
        "size": 30,
        "lineHeight": 40
      },
      "h2": {
        "family": "display",
        "weight": 600,
        "size": 22,
        "lineHeight": 30
      },
      "h3": {
        "family": "display",
        "weight": 600,
        "size": 18,
        "lineHeight": 26
      },
      "body": {
        "family": "body",
        "weight": 400,
        "size": 16,
        "lineHeight": 27
      },
      "body-medium": {
        "family": "body",
        "weight": 500,
        "size": 16,
        "lineHeight": 24
      },
      "body-small": {
        "family": "body",
        "weight": 400,
        "size": 14,
        "lineHeight": 22
      },
      "label": {
        "family": "body",
        "weight": 600,
        "size": 14,
        "lineHeight": 20
      },
      "number-l": {
        "family": "number",
        "weight": 600,
        "size": 20,
        "lineHeight": 28,
        "letterSpacing": -1
      },
      "number-m": {
        "family": "number",
        "weight": 500,
        "size": 15,
        "lineHeight": 22,
        "letterSpacing": -1
      }
    }
  },
  "radius": {
    "input": 8,
    "card": 10,
    "full": 9999
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32
  },
  "size": {
    "touch": 44,
    "content-max": 1080,
    "frame-mobile": 390,
    "frame-desktop": 1440,
    "bottom-nav": 56,
    "dialog-max": 560,
    "form-max": 640
  },
  "breakpoint": {
    "sm": 600,
    "md": 768,
    "lg": 1024,
    "xl": 1280
  },
  "motion": {
    "$note": "From docs/decisions/0001-stack.md (Animation). Durations in ms. lite = html[data-motion=lite]; reduce = html[data-motion=reduce] or prefers-reduced-motion (opacity fades of 100 ms or less).",
    "duration": {
      "press": 90,
      "hover": 160,
      "release": 160,
      "toast": 200,
      "tab": 220,
      "page": 240,
      "sheet": 280,
      "countup": 450
    },
    "lite": {
      "press": 60,
      "hover": 100,
      "release": 100,
      "toast": 140,
      "tab": 140,
      "page": 150,
      "sheet": 180,
      "countup": 300
    },
    "reduce": {
      "press": 0,
      "hover": 0,
      "release": 0,
      "toast": 100,
      "tab": 0,
      "page": 100,
      "sheet": 100,
      "countup": 0
    },
    "easing": {
      "out": "cubic-bezier(.2,0,0,1)",
      "in": "cubic-bezier(.3,0,1,1)"
    }
  },
  "$notes": {
    "overlay/*": "Not Figma variables: scrim and elevation shadow colours added for sheets and card lift; replace when the Figma effect styles are read.",
    "size/bottom-nav, size/dialog-max, size/form-max, breakpoint, motion": "From docs/decisions/0001-stack.md, not Figma."
  }
}
