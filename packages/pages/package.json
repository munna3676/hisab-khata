    "./fdr": "./src/fdr/index.ts",
    "./loan-eligibility": "./src/loan-eligibility/index.ts",
    "./loan-compare": "./src/loan-compare/index.ts",
    "./savings-goal": "./src/savings-goal/index.ts",
    "./vat": "./src/vat/index.ts",
    "./discount-percentage": "./src/discount-percentage/index.ts",
    "./profit-margin": "./src/profit-margin/index.ts",
    "./salary": "./src/salary/index.ts",
    "./income-tax": "./src/income-tax/index.ts",
    "./sanchayapatra": "./src/sanchayapatra/index.ts",
    "./currency-converter": "./src/currency-converter/index.ts",
