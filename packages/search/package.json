{
  "name": "@hisab/search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline search for হিসাব খাতা: Bangla/Banglish normalizer, MiniSearch index over the registry, and the intent parser behind answer cards.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:index": "node src/build-index.ts"
  },
  "dependencies": {
    "@hisab/core": "workspace:*",
    "@hisab/data": "workspace:*",
    "@hisab/i18n": "workspace:*",
    "minisearch": "7.2.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
