{
  "name": "@hisab/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed access to data/: the page registry, the data contract (JSON Schema + bounds, compiled to standalone validators), and the signed data store the app updates from.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validators": "node ../../scripts/build-validators.mjs",
    "check": "node ../../scripts/check-data.mjs --allow-unverified"
  },
  "dependencies": {
    "@hisab/core": "workspace:*",
    "@noble/ed25519": "3.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
